let ASRHits =
    DeviceEvents
    | where Timestamp >= ago(Lookback)
    | where ActionType startswith "Asr"
    | extend ParsedFields = parse_json(AdditionalFields)
    | extend
        RuleId = tolower(tostring(ParsedFields.RuleId)),
        AuditFlag = tolower(tostring(ParsedFields.IsAudit))
    | extend EventMode = case(
        ActionType endswith "Audited"
            or AuditFlag in ("true", "1"), "Audit",
        ActionType endswith "Blocked", "Block",
        ActionType contains "Warn", "Warn",
        "Other"
    )
    | where isnotempty(RuleId)
    | summarize
        AuditHits = countif(EventMode == "Audit"),
        BlockHits = countif(EventMode == "Block"),
        WarnHits = countif(EventMode == "Warn"),
        OtherHits = countif(EventMode == "Other"),
        AffectedDevices = dcount(DeviceId),
        AffectedUsers = dcount(
            strcat(
                InitiatingProcessAccountDomain,
                "\\",
                InitiatingProcessAccountName
            )
        ),
        FirstHit = min(Timestamp),
        LastHit = max(Timestamp),
        ActionTypes = make_set(ActionType, 20)
        by RuleId;
ASRRuleCatalog
| join kind=leftouter ASRHits on RuleId
| extend
    AuditHits = coalesce(AuditHits, long(0)),
    BlockHits = coalesce(BlockHits, long(0)),
    WarnHits = coalesce(WarnHits, long(0)),
    OtherHits = coalesce(OtherHits, long(0)),
    AffectedDevices = coalesce(AffectedDevices, long(0)),
    AffectedUsers = coalesce(AffectedUsers, long(0))
| extend HitStatus = case(
    AuditHits > 0 and BlockHits > 0, "Audit and Block hits",
    BlockHits > 0, "Block hits",
    AuditHits > 0, "Audit hits",
    WarnHits > 0, "Warn hits",
    OtherHits > 0, "Other telemetry",
    "No hits"
)
| project
    RuleName,
    RuleId,
    Category,
    HitStatus,
    AuditHits,
    BlockHits,
    WarnHits,
    OtherHits,
    AffectedDevices,
    AffectedUsers,
    FirstHit,
    LastHit,
    ActionTypes
| order by BlockHits desc, AuditHits desc, RuleName asc
